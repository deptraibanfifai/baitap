    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst result = item?.json ?? {};\n\nconst valid =\n  typeof result.postId === \"string\" &&\n  Number.isInteger(result.expectedVersion) &&\n  typeof result.structuralReady === \"boolean\" &&\n  Array.isArray(result.failedChecks) &&\n  result.contentFactsVerified === false &&\n  result.autoApproveAllowed === false &&\n  result.requiresHumanReview === true;\n\nif (!result.error && valid) {\n  // Normal policy response: post remains pending_review.\n  return [];\n}\n\n// Never include tokens, HTTP headers, or raw API errors in logs.\nreturn [{\n  json: {\n    executionId: `policy:${$execution.id}`,\n    message:\n      \"Policy Evaluation failed or returned an unexpected response. \" +\n      \"The post remains pending_review. Inspect the n8n execution.\"\n  }\n}];"
      },
