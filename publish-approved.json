    {
      "id": "a19d4ec2-5a1b-4a41-9e83-6f5c9a7d0101",
      "name": "Website publish succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1460,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
