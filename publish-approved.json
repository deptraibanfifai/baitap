          },
          "conditions": [
            {
              "id": "a19d4ec2-5a1b-4a41-9e83-6f5c9a7d0102",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 && $json.body?.status === 'published' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a19d4ec2-5a1b-4a41-9e83-6f5c9a7d0103",
      "name": "Prepare unknown publication failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        240
      ],
      "parameters": {
        "jsCode": "const result = $json;\nconst original = $('Prepare publication request').item.json;\n\nif (!original?.postId || original.expectedVersion === undefined ||\n    original.expectedVersion === null) {\n  throw new Error('Cannot safely report publication outcome: original post identity unavailable');\n}\n\nreturn {\n  json: {\n    postId: original.postId,\n    expectedVersion: original.expectedVersion,\n    message: String(\n      result.error?.message ||\n      result.body?.message ||\n      'Website publication result could not be confirmed'\n    ).slice(0, 1000),\n    outcome: 'unknown',\n    retryable: false\n  }\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "a19d4ec2-5a1b-4a41-9e83-6f5c9a7d0104",
      "name": "Report unknown publication failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL + '/api/internal/posts/' + $json.postId + '/publish-failed' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({expectedVersion:$json.expectedVersion,message:$json.message,outcome:'unknown',retryable:false}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "hitlHeaderAuth01",
          "name": "HITL shared secret"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const postId = $json.postId;\nconst expectedVersion = $json.expectedVersion;\n\nif (typeof postId !== 'string' || postId.length === 0) {\n  throw new Error('Missing postId; refusing to publish');\n}\nif (expectedVersion === undefined || expectedVersion === null) {\n  throw new Error('Missing expectedVersion; refusing to publish');\n}\n\nreturn { json: { postId, expectedVersion } };"
      },
      "id": "fffcd859-cf96-4767-8091-b79ce551c39e",
      "name": "Prepare publication request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        240
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Prepare publication request').item.json;\n\nif (!original?.postId || original.expectedVersion === undefined ||\n    original.expectedVersion === null) {\n  throw new Error('Cannot safely continue: original post identity unavailable');\n}\n\nif ($json.body?.status !== 'published') {\n  throw new Error('Website publication was not confirmed as published');\n}\n\nreturn {\n  json: {\n    postId: original.postId,\n    expectedVersion: original.expectedVersion,\n    status: 'published'\n  }\n};"
      },
      "id": "e7c33c0d-fc47-4476-b13d-d597042b15c0",
      "name": "Prepare confirmed publication",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
