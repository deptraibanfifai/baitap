    {
      "id": "4733e990-a28a-5f5b-8f03-c433538f2c8c",
      "name": "Due requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().flatMap(i=>{const rows=Array.isArray(i.json)?i.json:[i.json];return rows.filter(p=>p._id).map(p=>({json:{postId:p._id,expectedVersion:p.version}}));});"
      }
    },
    {
      "id": "573f5fcb-a26a-5521-a908-3c3320d231d8",
      "name": "Publish approved website version",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL + '/api/internal/posts/' + $json.postId + '/publish' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({expectedVersion:$json.expectedVersion}) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "hitlHeaderAuth01",
          "name": "HITL shared secret"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "31253da3-95f5-58a9-99a0-29d0a1fff055",
      "name": "Social mock enabled",
      "type": "n8n-nodes-base.if",
